{
  "schemaVersion": 1,
  "protocol": {
    "path": "docs/governance/TXKPRO_WAVE_IMPLEMENTATION_PROTOCOL.md",
    "version": "1.0",
    "effectiveDate": "2026-09-30",
    "authoritative": true
  },
  "repository": "QaloriHQ/txkpro-workforce",
  "roadmap": {
    "ownerType": "user",
    "owner": "QaloriHQ",
    "projectNumber": 1,
    "statusField": "Status",
    "nextRule": "first Planned candidate in canonical Project order whose task context resolves and automated dependency/Definition-of-Ready preflight passes, followed by required read-only agent confirmations",
    "plannedCandidateRule": "earliest-added open issue with authoritative Project Status = Planned",
    "nextEligibleCommand": "node scripts/roadmap-next-eligible.mjs --json",
    "plannedCandidateCommand": "node scripts/roadmap-next-planned.mjs --json"
  },
  "branches": {
    "staging": "staging",
    "default": "main",
    "developDirectlyOnStaging": false
  },
  "verification": {
    "browserStaging": "user_owned_unless_explicitly_requested",
    "nonBrowserStaging": "agent_authorized_when_protocol_allows",
    "baselineCommands": [
      "npm run typecheck",
      "npm run lint",
      "npm run build"
    ]
  },
  "production": {
    "deploymentRequiresExplicitUserAuthorization": true,
    "migrationsRequireExplicitUserAuthorization": true
  },
  "projectTransitions": {
    "evidenceGated": [
      "Verification",
      "Done"
    ],
    "workflow": ".github/workflows/protocol-status.yml",
    "manualIssueClosureDoesNotProveDone": true
  },
  "approvalBoundary": {
    "readOnlyPlanningPreflight": "automatic_no_user_approval_required",
    "mutation": "explicit_user_approval_required",
    "production": "separate_explicit_user_authorization_required"
  }
}
