{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "node ../build.mjs marketplace",
  "outputDirectory": "dist",
  "installCommand": "echo marketing-build-has-no-dependencies",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {"source": "/(.*)", "headers": [{"key": "X-Content-Type-Options", "value": "nosniff"}, {"key": "Referrer-Policy", "value": "strict-origin-when-cross-origin"}, {"key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'self'; form-action 'none'; connect-src https://qwxlgzlkaeaqfzjodtis.supabase.co"}]},
    {"source": "/ads.txt", "headers": [{"key": "Content-Type", "value": "text/plain; charset=utf-8"}]},
    {"source": "/llms.txt", "headers": [{"key": "Content-Type", "value": "text/plain; charset=utf-8"}]}
  ],
  "redirects": [
    {"source": "/home", "destination": "/", "permanent": true},
    {"source": "/about-us", "destination": "/about", "permanent": true},
    {"source": "/service-request", "destination": "/homeowners", "permanent": true},
    {"source": "/login", "destination": "https://app.txkpro.com", "permanent": true},
    {"source": "/login-signup", "destination": "https://app.txkpro.com", "permanent": true},
    {"source": "/ads-txt", "destination": "/ads.txt", "permanent": true},
    {"source": "/privacy-policy", "destination": "/privacy", "permanent": true},
    {"source": "/terms-of-service", "destination": "/terms", "permanent": true}
  ]
}
