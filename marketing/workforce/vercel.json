{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "node ../build.mjs workforce",
  "outputDirectory": "dist",
  "installCommand": "npm ci --prefix ../.. --ignore-scripts --no-audit --no-fund",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {"source": "/(.*)", "headers": [{"key": "X-Content-Type-Options", "value": "nosniff"}, {"key": "Referrer-Policy", "value": "strict-origin-when-cross-origin"}, {"key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'self'; form-action 'none'; connect-src 'self' https://qwxlgzlkaeaqfzjodtis.supabase.co"}]},
    {"source": "/ads.txt", "headers": [{"key": "Content-Type", "value": "text/plain; charset=utf-8"}]},
    {"source": "/llms.txt", "headers": [{"key": "Content-Type", "value": "text/plain; charset=utf-8"}]}
  ],
  "redirects": [
    {"source": "/workforce", "destination": "/", "permanent": true},
    {"source": "/home", "destination": "/", "permanent": true},
    {"source": "/about-us", "destination": "/about", "permanent": true},
    {"source": "/privacy-policy", "destination": "/privacy", "permanent": true},
    {"source": "/terms-of-service", "destination": "/terms", "permanent": true}
  ]
}
