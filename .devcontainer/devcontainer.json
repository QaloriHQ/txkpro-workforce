{
  "name": "TXKPRO Workforce",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:5.2.1-24-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "forwardPorts": [3000, 8788],
  "portsAttributes": {
    "3000": {
      "label": "TXKPRO Workforce",
      "onAutoForward": "openPreview"
    },
    "8788": {
      "label": "Cline Discord Bridge",
      "onAutoForward": "silent"
    }
  },
  "containerEnv": {
    "CLINE_API_PROVIDER": "openrouter",
    "CLINE_PROVIDER": "openrouter",
    "CLINE_PLAN_MODEL": "qwen/qwen3-coder",
    "CLINE_ACT_MODEL": "deepseek/deepseek-chat",
    "CLINE_PLAN_MAX_TOKENS": "8192",
    "CLINE_ACT_MAX_TOKENS": "16384",
    "TXKPRO_ROADMAP_OWNER": "QaloriHQ",
    "TXKPRO_ROADMAP_PROJECT_NUMBER": "1",
    "TXKPRO_ROADMAP_REPO": "QaloriHQ/txkpro-workforce",
    "DISCORD_APPLICATION_ID": "1554545511946526761",
    "CLINE_CONNECTOR_PORT": "8788"
  },
  "postCreateCommand": "bash .devcontainer/bootstrap-agent.sh",
  "postStartCommand": "bash .devcontainer/start-agent.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode"
      ]
    }
  }
}
