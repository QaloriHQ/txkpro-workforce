#!/usr/bin/env node

const fs = require("node:fs");
const os = require("node:os");
const path = require("node:path");
const { spawnSync } = require("node:child_process");

let input = {};
try {
  input = JSON.parse(fs.readFileSync(0, "utf8") || "{}");
} catch {
  process.stdout.write(JSON.stringify({ cancel: false }));
  process.exit(0);
}

const prompt = String(input?.userPromptSubmit?.prompt || "");
const rawTaskId = String(input?.taskId || "unknown");
const taskId = rawTaskId.replace(/[^A-Za-z0-9._-]/g, "_");
const workspaceRoot =
  Array.isArray(input?.workspaceRoots) && input.workspaceRoots[0]
    ? input.workspaceRoots[0]
    : process.cwd();
const dir = path.join(os.tmpdir(), "txkpro-cline-confirmation-gates");
const marker = path.join(dir, taskId + ".json");

function readMarker() {
  try {
    return JSON.parse(fs.readFileSync(marker, "utf8"));
  } catch {
    return null;
  }
}

function writeMarker(value) {
  fs.mkdirSync(dir, { recursive: true });
  fs.writeFileSync(marker, JSON.stringify(value, null, 2));
}

function isExplicitImplementationApproval(value) {
  const text = String(value || "").trim();
  return (
    /^(go|approve|approved|proceed|\/act|do it)\b/i.test(text) ||
    /^implement\b/i.test(text) ||
    /^make (these|the) changes\b/i.test(text) ||
    /^start implementation\b/i.test(text) ||
    /^complete .* now\b/i.test(text)
  );
}

function startUsageRun(gate) {
  const script = path.join(workspaceRoot, "scripts", "txkpro-agent-usage.mjs");
  const args = [
    script,
    "start",
    "--issue",
    String(gate.issue),
    "--task-id",
    String(gate.roadmapTaskId),
    "--cline-task-id",
    rawTaskId,
  ];

  const result = spawnSync(process.execPath, args, {
    cwd: workspaceRoot,
    encoding: "utf8",
    env: process.env,
  });

  if (result.error || result.status !== 0) {
    return {
      ok: false,
      error: String(
        result.stderr ||
          result.stdout ||
          result.error?.message ||
          "unknown agent-usage start error",
      ).trim(),
    };
  }

  return {
    ok: true,
    output: String(result.stdout || "").trim(),
  };
}

const isRoadmapNext =
  /\bwhat(?:'|’)s\s+next\b/i.test(prompt) ||
  /\bnext\s+eligible(?:\s+task)?\b/i.test(prompt) ||
  /\bnext\s+roadmap(?:\s+task)?\b/i.test(prompt);

if (isRoadmapNext) {
  writeMarker({
    taskId,
    rawTaskId,
    state: "READ_ONLY_CONFIRMATIONS_REQUIRED",
    createdAt: new Date().toISOString(),
  });

  process.stdout.write(
    JSON.stringify({
      cancel: false,
      contextModification:
        "TXKPRO ROADMAP CONTINUATION GATE: This is a What's next?/next-eligible request. Run the dependency-aware selector, then continue automatically through ALL required read-only confirmations in this same turn. Do not ask whether to gather confirmation details. Before finishing, create a temporary confirmation evidence JSON with all eight required confirmations and validate it with: node scripts/txkpro-confirmation-check.mjs --evidence <path>. Until that command returns TXKPRO_CONFIRMATIONS_CONFIRMED, do not ask a follow-up question, do not attempt completion, and do not claim the task is confirmed eligible. Mutation remains unauthorized until explicit owner approval.",
    }),
  );
  process.exit(0);
}

const gate = readMarker();
if (
  gate?.state === "CONFIRMED_AWAITING_APPROVAL" &&
  gate?.issue &&
  gate?.roadmapTaskId &&
  isExplicitImplementationApproval(prompt)
) {
  const usage = startUsageRun(gate);
  if (!usage.ok) {
    process.stdout.write(
      JSON.stringify({
        cancel: true,
        errorMessage:
          "TXKPRO could not create the required pre-run token-usage record in the GitHub issue: " +
          usage.error,
        contextModification:
          "Do not mutate implementation files until the per-run usage estimate has been recorded. Fix the GitHub/Cline telemetry prerequisite, then retry the approved implementation.",
      }),
    );
    process.exit(0);
  }

  writeMarker({
    ...gate,
    state: "IMPLEMENTATION_RUN_ACTIVE",
    implementationApprovedAt: new Date().toISOString(),
    usageRunStarted: true,
  });

  process.stdout.write(
    JSON.stringify({
      cancel: false,
      contextModification:
        "TXKPRO agent-usage PRE-RUN record has been written to the issue for " +
        gate.roadmapTaskId +
        " (#" +
        gate.issue +
        "). Continue the approved implementation. Token/cost actuals must be synchronized to the same issue before this run may complete. Production deployment remains separately authorized.",
    }),
  );
  process.exit(0);
}

process.stdout.write(JSON.stringify({ cancel: false }));
