#!/usr/bin/env node

const fs = require("node:fs");
const os = require("node:os");
const path = require("node:path");
const { spawnSync } = require("node:child_process");

let input = {};
try {
  input = JSON.parse(fs.readFileSync(0, "utf8") || "{}");
} catch {
  process.stdout.write(JSON.stringify({ cancel: false }));
  process.exit(0);
}

const rawTaskId = String(input?.taskId || "unknown");
const taskId = rawTaskId.replace(/[^A-Za-z0-9._-]/g, "_");
const workspaceRoot =
  Array.isArray(input?.workspaceRoots) && input.workspaceRoots[0]
    ? input.workspaceRoots[0]
    : process.cwd();
const { extractPresentationText, sha256 } = require(
  path.join(workspaceRoot, "scripts", "txkpro-eligibility-result.cjs"),
);
const marker = path.join(
  os.tmpdir(),
  "txkpro-cline-confirmation-gates",
  taskId + ".json",
);
const toolName = String(input?.preToolUse?.toolName || "");
const parameters = input?.preToolUse?.parameters || {};

function readMarker() {
  try {
    return JSON.parse(fs.readFileSync(marker, "utf8"));
  } catch {
    return null;
  }
}

function writeMarker(value) {
  fs.mkdirSync(path.dirname(marker), { recursive: true });
  fs.writeFileSync(marker, JSON.stringify(value, null, 2));
}

function runUsage(args) {
  const script = path.join(workspaceRoot, "scripts", "txkpro-agent-usage.mjs");
  const result = spawnSync(process.execPath, [script, ...args], {
    cwd: workspaceRoot,
    encoding: "utf8",
    env: process.env,
  });

  return {
    ok: !result.error && result.status === 0,
    status: result.status,
    stdout: String(result.stdout || "").trim(),
    stderr: String(result.stderr || "").trim(),
  };
}

function commandLooksMutating(value) {
  const command = Array.isArray(value)
    ? value.join("\n")
    : typeof value === "object" && value !== null
      ? JSON.stringify(value)
      : String(value || "");

  return /(^|\s)(git\s+(commit|push|merge|checkout|switch|reset|clean)|npm\s+(install|uninstall)|pnpm\s+(add|remove|install)|yarn\s+(add|remove|install)|supabase\s+(db\s+push|migration|functions\s+deploy)|vercel\s+(deploy|--prod)|rm\s|mv\s|cp\s|mkdir\s|touch\s|sed\s+-i|tee\s|apply_patch|cat\s+>)/i.test(
    command,
  );
}

function toolLooksMutating(name, params) {
  const mutatingTools = new Set([
    "write_to_file",
    "replace_in_file",
    "apply_diff",
    "apply_patch",
    "editor",
    "str_replace_editor",
    "search_and_replace",
    "insert_content",
    "edit_file",
    "create_file",
    "delete_file",
  ]);

  if (mutatingTools.has(name)) return true;
  if (name === "execute_command" || name === "run_commands") {
    return commandLooksMutating(
      params?.command ?? params?.commands ?? params?.cmd ?? params,
    );
  }
  return false;
}

function isAllowedTemporaryEvidenceWrite(name, params) {
  if (!["write_to_file", "create_file"].includes(name)) return false;
  const target = String(
    params?.path ?? params?.file_path ?? params?.filePath ?? "",
  ).trim();
  if (!target) return false;
  const resolved = path.resolve(workspaceRoot, target);
  const temporaryRoot = path.resolve(os.tmpdir()) + path.sep;
  return resolved.startsWith(temporaryRoot) && resolved.endsWith(".json");
}

const gate = readMarker();
if (!gate) {
  process.stdout.write(JSON.stringify({ cancel: false }));
  process.exit(0);
}

const completionTools = new Set(["attempt_completion", "submit_and_exit"]);
const questionTools = new Set(["ask_followup_question", "ask_question"]);
const modeTools = new Set(["switch_mode", "switch_to_act_mode"]);

if (gate.state === "READ_ONLY_CONFIRMATIONS_REQUIRED") {
  const blockedTools = new Set([
    ...completionTools,
    ...questionTools,
    ...modeTools,
  ]);

  if (isAllowedTemporaryEvidenceWrite(toolName, parameters)) {
    process.stdout.write(JSON.stringify({ cancel: false }));
    process.exit(0);
  }

  if (!blockedTools.has(toolName) && !toolLooksMutating(toolName, parameters)) {
    process.stdout.write(JSON.stringify({ cancel: false }));
    process.exit(0);
  }

  process.stdout.write(
    JSON.stringify({
      cancel: true,
      errorMessage:
        "TXKPRO read-only confirmation gate is still pending. Continue the mandatory read-only analysis; do not ask the user for permission and do not complete the task yet.",
      contextModification:
        "Resolve all eight required confirmations from authoritative sources and actual non-secret state now. First read .github/TXKPRO_READONLY_CONFIRMATION_TEMPLATE.json and scripts/txkpro-confirmation-check.mjs; never guess the schema. Do not infer or assume a confirmation. Each evidence entry must include source, finding, locator or checkType, typed assertion {subject,predicate,values}, and supported verification bound to that assertion. Include implementationPlan.contract sourced-plan-v1 with complete constrained-kind coverage. Temporary evidence creation is permitted only as a JSON file under the system temporary directory; repository mutation remains blocked. Run node scripts/txkpro-confirmation-check.mjs --evidence <path>. Sentinel strings alone do not clear the gate: the exact successful invocation and verified canonical result artifact are also required. If a source does not establish the needed fact, mark the confirmation BLOCKED or UNRESOLVED and continue automatically to the next provisional candidate.",
    }),
  );
  process.exit(0);
}

if (gate.state === "ELIGIBILITY_CONFIRMED_READY_TO_PRESENT") {
  if (questionTools.has(toolName) || modeTools.has(toolName)) {
    process.stdout.write(
      JSON.stringify({
        cancel: true,
        errorMessage:
          "TXKPRO eligibility is validator-attested but has not been presented through the canonical completion payload.",
        contextModification:
          "Use submit_and_exit or attempt_completion with the exact canonical presentation stored by the runtime. Do not add unsupported claims or switch to mutation mode.",
      }),
    );
    process.exit(0);
  }

  if (completionTools.has(toolName)) {
    const presentation = extractPresentationText(parameters);
    const expected = String(gate.canonicalPresentation || "").trim();
    const digestMatches =
      expected &&
      gate.presentationSha256 &&
      sha256(expected) === gate.presentationSha256;
    if (!digestMatches || presentation !== expected) {
      process.stdout.write(
        JSON.stringify({
          cancel: true,
          errorMessage:
            "TXKPRO eligibility presentation must exactly match the validator-generated canonical result.",
          contextModification:
            "Submit the canonical presentation exactly as stored in the runtime gate. Do not add inferred roles, ownership, statuses, events, routes, credentials, UAT owners, or blockers.",
        }),
      );
      process.exit(0);
    }

    writeMarker({
      ...gate,
      state: "CONFIRMED_AWAITING_APPROVAL",
      eligibilityPresentedAt: new Date().toISOString(),
    });
    process.stdout.write(
      JSON.stringify({
        cancel: false,
        contextModification:
          "TXKPRO canonical eligibility result verified for presentation. Mutation remains unauthorized pending explicit owner approval.",
      }),
    );
    process.exit(0);
  }

  if (toolLooksMutating(toolName, parameters)) {
    process.stdout.write(
      JSON.stringify({
        cancel: true,
        errorMessage:
          "TXKPRO mutation is blocked until the canonical eligibility result is presented and the owner explicitly approves implementation.",
      }),
    );
    process.exit(0);
  }
}

if (gate.state === "CONFIRMED_AWAITING_APPROVAL") {
  if (!toolLooksMutating(toolName, parameters)) {
    process.stdout.write(JSON.stringify({ cancel: false }));
    process.exit(0);
  }

  process.stdout.write(
    JSON.stringify({
      cancel: true,
      errorMessage:
        "TXKPRO mutation is not authorized yet. The next eligible task is confirmed, but explicit owner approval and the PRE-RUN issue usage record are still required.",
      contextModification:
        "Present or preserve the implementation plan and wait for explicit owner approval. After approval, the UserPromptSubmit hook will create the required estimated token-usage record in the GitHub issue before mutation begins.",
    }),
  );
  process.exit(0);
}

if (
  gate.state === "IMPLEMENTATION_RUN_ACTIVE" &&
  completionTools.has(toolName)
) {
  const finish = runUsage([
    "finish",
    "--cline-task-id",
    rawTaskId,
    "--outcome",
    "agent_run_finished",
  ]);

  if (!finish.ok) {
    process.stdout.write(
      JSON.stringify({
        cancel: true,
        errorMessage:
          "TXKPRO cannot complete this agent run until actual token/cost telemetry has been synchronized to the GitHub issue. " +
          (finish.stderr || finish.stdout || "Usage finalization failed."),
        contextModification:
          "Do not invent token counts. Resolve the Cline telemetry source or run the usage finalizer with a valid telemetry source, then retry completion.",
      }),
    );
    process.exit(0);
  }

  writeMarker({
    ...gate,
    state: "RUN_COMPLETE",
    usageRunFinishedAt: new Date().toISOString(),
  });

  process.stdout.write(
    JSON.stringify({
      cancel: false,
      contextModification:
        "TXKPRO POST-RUN token/cost actuals have been synchronized to the issue. The implementation run may complete. GitHub now contains the pre-run estimate, post-run actuals, estimate variance, and cumulative issue usage.",
    }),
  );
  process.exit(0);
}

process.stdout.write(JSON.stringify({ cancel: false }));
