#!/usr/bin/env node

const fs = require("node:fs");
const os = require("node:os");
const path = require("node:path");
const { spawnSync } = require("node:child_process");

let input = {};
try {
  input = JSON.parse(fs.readFileSync(0, "utf8") || "{}");
} catch {
  process.stdout.write(JSON.stringify({ cancel: false }));
  process.exit(0);
}

const rawTaskId = String(input?.taskId || "unknown");
const taskId = rawTaskId.replace(/[^A-Za-z0-9._-]/g, "_");
const workspaceRoot =
  Array.isArray(input?.workspaceRoots) && input.workspaceRoots[0]
    ? input.workspaceRoots[0]
    : process.cwd();
const {
  isSelectorInvocation,
  parseValidatorInvocation,
  validateResultArtifact,
} = require(path.join(workspaceRoot, "scripts", "txkpro-eligibility-result.cjs"));
const dir = path.join(os.tmpdir(), "txkpro-cline-confirmation-gates");
const marker = path.join(dir, taskId + ".json");
const resultValue = input?.postToolUse?.result;
const result =
  typeof resultValue === "string"
    ? resultValue
    : JSON.stringify(resultValue ?? "");
const toolName = String(input?.postToolUse?.toolName || "");
const parameters =
  input?.postToolUse?.parameters ||
  input?.postToolUse?.toolParameters ||
  input?.postToolUse?.input ||
  {};
const toolSuccess = input?.postToolUse?.success === true;
const executionTimeMs = Number(input?.postToolUse?.executionTimeMs || 0);

function readMarker() {
  try {
    return JSON.parse(fs.readFileSync(marker, "utf8"));
  } catch {
    return null;
  }
}

function writeMarker(value) {
  fs.mkdirSync(dir, { recursive: true });
  fs.writeFileSync(marker, JSON.stringify(value, null, 2));
}

function parseConfirmationSummary(text) {
  const issueMatch = String(text).match(/"issue"\s*:\s*(\d+)/);
  const taskMatch = String(text).match(/"taskId"\s*:\s*"([^"]+)"/);
  return {
    issue: issueMatch ? Number(issueMatch[1]) : null,
    roadmapTaskId: taskMatch ? taskMatch[1] : null,
  };
}

function runUsage(args) {
  const script = path.join(workspaceRoot, "scripts", "txkpro-agent-usage.mjs");
  const response = spawnSync(process.execPath, [script, ...args], {
    cwd: workspaceRoot,
    encoding: "utf8",
    env: process.env,
  });

  return {
    ok: !response.error && response.status === 0,
    status: response.status,
    stdout: String(response.stdout || "").trim(),
    stderr: String(response.stderr || "").trim(),
  };
}

let gate = readMarker();
if (
  gate?.state === "READ_ONLY_CONFIRMATIONS_REQUIRED" &&
  toolSuccess &&
  isSelectorInvocation(toolName, parameters) &&
  (result.includes("AUTOMATED_GATE_PASSED_CONFIRMATIONS_PENDING") ||
    result.includes('"readOnlyConfirmationsRequired": true') ||
    result.includes('"readOnlyConfirmationsRequired":true'))
) {
  const summary = parseConfirmationSummary(result);
  if (summary.issue && summary.roadmapTaskId) {
    gate = {
      ...gate,
      issue: summary.issue,
      roadmapTaskId: summary.roadmapTaskId,
      candidateSelectedAt: new Date().toISOString(),
    };
    writeMarker(gate);
  }
  process.stdout.write(
    JSON.stringify({
      cancel: false,
      contextModification: summary.issue && summary.roadmapTaskId
        ? "TXKPRO provisional candidate bound to the runtime gate: " +
          summary.roadmapTaskId +
          " (#" +
          summary.issue +
          "). Continue all eight read-only confirmations and run the exact validator command before presenting eligibility."
        : "TXKPRO selector output did not expose a candidate issue and Task ID. Keep the gate pending and rerun the dependency-aware selector; do not infer the candidate.",
    }),
  );
  process.exit(0);
}

const validatorInvocation = parseValidatorInvocation(
  toolName,
  parameters,
  workspaceRoot,
);
if (validatorInvocation && gate?.state === "READ_ONLY_CONFIRMATIONS_REQUIRED") {
  if (!toolSuccess) {
    process.stdout.write(
      JSON.stringify({
        cancel: false,
        contextModification:
          "TXKPRO validator execution failed. Keep the read-only gate pending and correct the reported evidence or execution error.",
      }),
    );
    process.exit(0);
  }
  if (!gate.issue || !gate.roadmapTaskId) {
    process.stdout.write(
      JSON.stringify({
        cancel: false,
        contextModification:
          "TXKPRO validator output cannot clear an unbound gate. Run the dependency-aware selector first so the provisional issue and Task ID are recorded.",
      }),
    );
    process.exit(0);
  }
  const bothSentinels =
    result.includes("TXKPRO_CONFIRMATIONS_CONFIRMED") &&
    result.includes("TXKPRO_PLAN_CONTRACT_CONFIRMED");
  if (!bothSentinels) {
    process.stdout.write(
      JSON.stringify({
        cancel: false,
        contextModification: result.includes("TXKPRO_CONFIRMATIONS_BLOCKED")
          ? "TXKPRO confirmation evidence for this provisional candidate is BLOCKED/UNRESOLVED. Keep the gate active and continue automatically to the next provisional candidate."
          : "TXKPRO validator did not emit both required success sentinels. Keep the read-only gate active and repair the evidence without asking the owner to continue.",
      }),
    );
    process.exit(0);
  }

  const validated = validateResultArtifact({
    artifactPath: validatorInvocation.resultPath,
    evidencePath: validatorInvocation.evidencePath,
    workspaceRoot,
    gate,
  });
  if (!validated.ok) {
    process.stdout.write(
      JSON.stringify({
        cancel: false,
        contextModification:
          "TXKPRO validator output was not accepted because its canonical result artifact failed runtime attestation: " +
          validated.errors.join("; ") +
          ". Keep the gate pending.",
      }),
    );
    process.exit(0);
  }

  const artifact = validated.artifact;
  writeMarker({
    ...gate,
    state: "ELIGIBILITY_CONFIRMED_READY_TO_PRESENT",
    evidencePath: artifact.evidencePath,
    evidenceSha256: artifact.evidenceSha256,
    resultPath: artifact.resultPath,
    resultContract: artifact.resultContract,
    validatorSha256: artifact.validatorSha256,
    repositoryHead: artifact.repositoryHead,
    evidenceContract: artifact.evidenceContract,
    planContract: artifact.planContract,
    confirmationSentinelSeen: true,
    planSentinelSeen: true,
    canonicalPresentation: artifact.canonicalPresentation,
    presentationSha256: artifact.presentationSha256,
    confirmationsCompletedAt: artifact.validatedAt,
  });

  process.stdout.write(
    JSON.stringify({
      cancel: false,
      contextModification:
        "TXKPRO validator-attested eligibility is ready to present. Submit exactly the canonical presentation below with no additional eligibility, ownership, status, event, route, credential, or UAT claims:\n\n" +
        artifact.canonicalPresentation,
    }),
  );
  process.exit(0);
}

if (
  gate?.state === "READ_ONLY_CONFIRMATIONS_REQUIRED" &&
  (result.includes("TXKPRO_CONFIRMATIONS_CONFIRMED") ||
    result.includes("TXKPRO_PLAN_CONTRACT_CONFIRMED"))
) {
  process.stdout.write(
    JSON.stringify({
      cancel: false,
      contextModification:
        "TXKPRO sentinel text from a non-attested tool invocation was ignored. Only the exact successful validator command plus its verified result artifact can clear the gate.",
    }),
  );
  process.exit(0);
}

if (gate?.state === "IMPLEMENTATION_RUN_ACTIVE") {
  const observation = runUsage([
    "observe",
    "--cline-task-id",
    rawTaskId,
    "--success",
    toolSuccess ? "true" : "false",
    "--execution-ms",
    Number.isFinite(executionTimeMs) ? String(executionTimeMs) : "0",
  ]);

  if (observation.ok) {
    try {
      const parsed = JSON.parse(observation.stdout);
      if (
        parsed?.budgetStateChanged &&
        ["WARNING", "SOFT_BUDGET", "ESCALATION"].includes(parsed?.budgetState)
      ) {
        const messages = {
          WARNING:
            "TXKPRO token usage has crossed the run warning threshold. Continue only while making measurable progress; avoid unnecessary repository rereads and repeated repair loops.",
          SOFT_BUDGET:
            "TXKPRO token usage has crossed the soft budget. Record the reason for variance in the final run summary and continue only if the current repair/verification path is productive.",
          ESCALATION:
            "TXKPRO token usage has crossed the escalation threshold. Check for repeated failures, circular debugging, redundant context reads, or stalled progress. If the run is genuinely stuck, stop safely and report the blocker rather than consuming tokens indefinitely.",
        };

        process.stdout.write(
          JSON.stringify({
            cancel: false,
            contextModification: messages[parsed.budgetState],
          }),
        );
        process.exit(0);
      }
    } catch {
      // Observation is advisory; do not block the active implementation.
    }
  }
}

process.stdout.write(JSON.stringify({ cancel: false }));
