# Public Supabase config
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only key. Never expose this in client code.
SUPABASE_SERVICE_ROLE_KEY=

# Development mode. When true, /demo/* works without authentication.
TXKPRO_DEMO_MODE=true

# Protect the daily retention-pulse endpoint.
CRON_SECRET=replace-me

# Twilio Programmable Messaging
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Exact public URL Twilio calls; required for signature validation in production.
TWILIO_INBOUND_WEBHOOK_URL=
