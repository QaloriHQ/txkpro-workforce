# Public app origin used in Supabase Auth email redirects.
# Production example: https://workforce.txkpro.com
# During Codespaces development, leaving this blank uses the current browser origin.
NEXT_PUBLIC_SITE_URL=

# Public Supabase config
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only Supabase key. Prefer the modern sb_secret_* key when available.
# Never expose either value in client code or commit .env.local.
SUPABASE_SECRET_KEY=
# Legacy fallback supported during migration.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only Mapbox token used for permanent neighborhood geocoding and static geofence previews.
# The Mapbox account must permit permanent geocoding storage.
MAPBOX_ACCESS_TOKEN=

# Development mode. When true, /demo/* remains available as a product preview.
TXKPRO_DEMO_MODE=true

# Protect the daily retention-pulse endpoint.
CRON_SECRET=replace-me

# Twilio Programmable Messaging — Workforce transactional program only.
# Use "mock" only for controlled non-production tests. Default/live mode requires real Twilio credentials.
# This Messaging Service must be attached to the TXKPRO Workforce A2P campaign.
# Do not reuse the TXK Home Services Messaging Service here.
TXKPRO_SMS_MODE=live
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WORKFORCE_MESSAGING_SERVICE_SID=
# Exact public URL Twilio calls; required for signature validation in production.
TWILIO_INBOUND_WEBHOOK_URL=
# Server-only Twilio Email transport. Use replacement credentials in secure settings.
TWILIO_EMAIL_ENABLED=false
TWILIO_EMAIL_ACCOUNT_SID=
TWILIO_EMAIL_AUTH_TOKEN=
TWILIO_EMAIL_FROM_ADDRESS=TJ@txkpro.com
TWILIO_EMAIL_FROM_NAME=TJ
